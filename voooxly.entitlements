<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Entitlements for the hardened runtime (notarization requirement).
     The first three are the standard ones for PyInstaller apps: Python needs
     unsigned executable memory (ctypes/FFI), the bootloader uses DYLD
     variables, and we load vendored dylibs (whisper/ggml).
     audio-input is MANDATORY: with hardened runtime, without it macOS denies
     the microphone silently (it does not even draw the permission dialog). The
     development build did not need it because it has no hardened runtime. -->
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
